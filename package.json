{
  "name": "shared-reading-lists",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && npm run build:setup",
    "build:setup": "esbuild scripts/setup.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=build/setup.mjs",
    "start": "node build/setup.mjs && NODE_ENV=production NODE_OPTIONS=\"--import ./instrument.server.mjs\" react-router-serve ./build/server/index.js",
    "db:generate": "drizzle-kit generate",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint . && prettier --check . && depcruise app scripts tests --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "@sentry/react-router": "11.1.0",
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "dependency-cruiser": "18.4.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
